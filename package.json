{
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"test": "vitest",
		"test:run": "vitest run",
		"build-ssr": "tsc && vite build && vite build --ssr",
		"serve": "concurrently -k \"php artisan serve\" \"npm run dev\"",
		"serve-ssr": "concurrently -k \"php artisan serve\" \"npm run dev\" \"php artisan inertia:start-ssr\""
	},
	"devDependencies": {
		"@headlessui/react": "^2.2.10",
		"@inertiajs/react": "^3.6.1",
		"@tailwindcss/forms": "^0.5.3",
		"@types/node": "^20.19.43",
		"@types/react": "^18.0.28",
		"@types/react-dom": "^18.0.10",
		"@vitejs/plugin-react": "^4.7.0",
		"autoprefixer": "^10.4.12",
		"axios": "^1.6.4",
		"concurrently": "^9.2.1",
		"daisyui": "^4.12.24",
		"laravel-vite-plugin": "^2.1.0",
		"postcss": "^8.4.31",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwindcss": "^3.4.19",
		"typescript": "^5.0.2",
		"vite": "^7.3.6",
		"vitest": "^2.1.9"
	},
	"dependencies": {
		"@inertiajs/vite": "^3.6.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.23.26",
		"lucide-react": "^1.14.0",
		"react-icons": "^5.5.0",
		"react-image-gallery": "^2.1.2"
	},
	"prettier": {
		"semi": false,
		"useTabs": true,
		"trailingComma": "all",
		"singleAttributePerLine": false,
		"bracketSpacing": true,
		"arrowParens": "always",
		"plugins": [
			"prettier-plugin-tailwindcss"
		]
	}
}
