{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-ssr": "tsc && vite build && vite build --ssr",
        "serve": "concurrently -k \"php artisan serve\" \"npm run dev\"",
        "serve-ssr": "concurrently -k \"php artisan serve\" \"npm run dev\" \"php artisan inertia:start-ssr\""
    },
