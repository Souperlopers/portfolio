{
	"compilerOptions": {
        "skipLibCheck": true, // ✅ Skip checking node_modules types
		"allowJs": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"types": ["vitest/globals"],
		"strict": true,
		"isolatedModules": true,
		"target": "ESNext",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"paths": {
			"@/*": ["./resources/js/*"],
			"ziggy-js": ["./vendor/tightenco/ziggy"]
		}
	},
	"include": [
		"resources/js/**/*.ts",
		"resources/js/**/*.tsx",
		"resources/js/**/*.d.ts",
		"vitest.config.ts"
	],
	"exclude": [
		"node_modules",
		"resources/js/test/**/*" // ✅ Exclude tests from type checking
	]
}
